generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  NHAN_VIEN
  QUAN_LY
  CHU_SO_HUU
}

enum ServiceCategory {
  CA_PHE
  SPA
}

// Hình thức thanh toán cho từng lượt dịch vụ (Chức năng 1)
enum PaymentMethod {
  GHI_PHONG
  TIEN_MAT
  CHUYEN_KHOAN
}

// Hình thức cho Thu phòng / Chi phí (không có "ghi phòng")
enum CashMethod {
  TIEN_MAT
  CHUYEN_KHOAN
}

enum ShiftType {
  SANG
  CHIEU
  DEM
}

enum OtaPlatform {
  AGODA
  CTRIP
  BOOKING
  KHAC
}

enum ExpenseCategory {
  MAT_BANG
  LUONG
  MUA_HANG
  KHAC
}

// Chuyển khoản Thu phòng có thể vào tài khoản cá nhân của Ngọc Tiên hoặc thẳng tài khoản Cô Vân —
// nếu vào tài khoản Tiên thì sau đó còn phải chuyển tiếp cho Cô Vân, cần theo dõi riêng để tránh nhầm.
enum TransferAccount {
  TIEN
  VAN
}

enum PendingReceivableStatus {
  PENDING
  COLLECTED
}

model User {
  id                String   @id @default(cuid())
  name              String
  username          String   @unique
  passwordHash      String
  role              Role     @default(NHAN_VIEN)
  canManageCashbook Boolean  @default(false)
  // Người duy nhất thật sự quản lý app (Ngọc Tiên) — có toàn quyền: Sổ Thu Chi, Báo cáo, Quản trị,
  // sửa/xoá khoản bất kỳ ai. Quản lý/Chủ sở hữu khác (Cô Vân, Thầy Thành) chỉ xem được Báo cáo.
  isAppAdmin        Boolean  @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  serviceRecords      ServiceRecord[]
  roomRevenueEntries  RoomRevenueEntry[]
  otaReceivables      OtaReceivable[]
  expenses            Expense[]
  handoversGiven      ShiftHandover[]     @relation("HandoverUser")
  handoversReceived   ShiftHandover[]     @relation("ReceiverUser")
  pendingReceivablesRecorded  PendingReceivable[] @relation("RecordedByUser")
  pendingReceivablesCollected PendingReceivable[] @relation("CollectedByUser")
  ownerTransfers              OwnerTransfer[]
  unassignedAttachments       UnassignedAttachment[]
}

model MenuItem {
  id        String          @id @default(cuid())
  category  ServiceCategory
  name      String
  price     Int
  active    Boolean         @default(true)
  sortOrder Int             @default(0)

  serviceRecords ServiceRecord[]
}

// Chức năng 1 — ghi nhận từng lượt dịch vụ Cà phê / Spa
model ServiceRecord {
  id            String          @id @default(cuid())
  time          DateTime        @default(now())
  category      ServiceCategory
  roomOrGuest   String
  content       String
  quantity      Int             @default(1)
  unitPrice     Int
  amount        Int
  paymentMethod PaymentMethod

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])

  recordedByUserId String
  recordedByUser   User   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([time])
  @@index([recordedByUserId])
}

// Sổ Thu Chi — Thu phòng (chị Tiên nhập)
model RoomRevenueEntry {
  id            String     @id @default(cuid())
  time          DateTime   @default(now())
  amount        Int
  method        CashMethod
  transferAccount TransferAccount?
  note          String?
  attachmentUrls String[] @default([])

  recordedByUserId String
  recordedByUser   User   @relation(fields: [recordedByUserId], references: [id])

  pendingReceivable PendingReceivable?

  createdAt DateTime @default(now())

  @@index([time])
}

// Khoản khách còn nợ trực tiếp khách sạn (khác OTA công nợ — đây là khách đặt thẳng, không qua sàn),
// vd sổ tay ghi "cọc 500, còn thu 1.500.000" — phần "còn thu" chưa có tiền thật, cần theo dõi để
// không quên, và để bất kỳ ai (ca sau, ngày khác) thu được thì đánh dấu "Đã thu" — lúc đó mới tạo
// khoản Thu phòng thật.
model PendingReceivable {
  id     String                  @id @default(cuid())
  time   DateTime                @default(now())
  amount Int
  note   String?
  status PendingReceivableStatus @default(PENDING)

  collectedMethod         CashMethod?
  collectedTransferAccount TransferAccount?
  collectedAt              DateTime?
  collectedByUserId        String?
  collectedByUser          User?     @relation("CollectedByUser", fields: [collectedByUserId], references: [id])
  roomRevenueEntryId       String?   @unique
  roomRevenueEntry         RoomRevenueEntry? @relation(fields: [roomRevenueEntryId], references: [id])

  recordedByUserId String
  recordedByUser   User   @relation("RecordedByUser", fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
}

// Mỗi lần Ngọc Tiên đưa/chuyển tiền cho Cô Vân — 2 trường hợp:
// - CHUYEN_KHOAN: tiền khách đã chuyển khoản vào TK cá nhân Tiên, nay chuyển trả lại Cô Vân qua
//   ngân hàng — có ảnh chuyển khoản làm bằng chứng. Số dư "còn cần chuyển" chỉ tính loại này
//   (= tổng RoomRevenueEntry(transferAccount=TIEN) trừ tổng OwnerTransfer loại CHUYEN_KHOAN).
// - TIEN_MAT: tiền mặt tại quầy đưa trực tiếp cho Cô Vân (không phải chi phí kinh doanh) — chỉ
//   dùng để trừ vào "Tiền mặt tại quầy" (xem sumCashSince trong lib/cash.ts), không ảnh hưởng
//   Tổng chi/Chênh lệch Thu-Chi vì đây không phải một khoản chi thật.
model OwnerTransfer {
  id            String     @id @default(cuid())
  time          DateTime   @default(now())
  amount        Int
  method        CashMethod @default(CHUYEN_KHOAN)
  note          String?
  attachmentUrls String[] @default([])

  recordedByUserId String
  recordedByUser   User   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([time])
}

// Kho ảnh chứng từ — up ảnh nhanh (vd ảnh chuyển khoản của ngày trước, quên up lúc ghi) mà KHÔNG
// cần điền số liệu kế toán ngay. Sau đó gắn ảnh này vào 1 OwnerTransfer có sẵn, hoặc tạo mới từ
// ảnh — lúc đó ảnh mới rời khỏi kho (xoá row này, url chuyển sang OwnerTransfer.attachmentUrls).
// Ảnh không bao giờ gắn vào đâu thì vẫn nằm im ở đây — đúng nghĩa lưu trữ dự phòng.
model UnassignedAttachment {
  id     String   @id @default(cuid())
  url    String
  note   String?
  time   DateTime @default(now())

  recordedByUserId String
  recordedByUser   User   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([time])
}

// Sổ Thu Chi — OTA công nợ (chị Tiên nhập, chỉ ghi tổng phát sinh/ngày)
model OtaReceivable {
  id            String      @id @default(cuid())
  date          DateTime    @default(now())
  platform      OtaPlatform
  amount        Int
  note          String?
  attachmentUrls String[] @default([])

  recordedByUserId String
  recordedByUser   User   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([date])
}

// Sổ Thu Chi — Chi phí (chị Tiên nhập)
model Expense {
  id            String          @id @default(cuid())
  time          DateTime        @default(now())
  category      ExpenseCategory
  amount        Int
  method        CashMethod
  note          String
  attachmentUrls String[] @default([])

  recordedByUserId String
  recordedByUser   User   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([time])
}

// Chức năng 2 — Biên bản bàn giao ca
model ShiftHandover {
  id        String    @id @default(cuid())
  date      DateTime  @default(now())
  shiftType ShiftType

  // Mốc bắt đầu tính gộp doanh thu/chi phí của ca này (= thời điểm xác nhận ca trước)
  periodStart DateTime

  handoverUserId String
  handoverUser   User   @relation("HandoverUser", fields: [handoverUserId], references: [id])
  receiverUserId String
  receiverUser   User   @relation("ReceiverUser", fields: [receiverUserId], references: [id])

  cashStart         Int
  roomRevenue       Int  @default(0) // auto = Σ RoomRevenueEntry(TIEN_MAT) trong ca
  cafeRevenue       Int  @default(0) // auto = Σ ServiceRecord(CA_PHE, TIEN_MAT) trong ca
  spaRevenue        Int  @default(0) // auto = Σ ServiceRecord(SPA, TIEN_MAT) trong ca
  otherExpense      Int  @default(0) // auto = Σ Expense(TIEN_MAT) trong ca
  ownerCashOut      Int  @default(0) // auto = Σ OwnerTransfer(TIEN_MAT) trong ca — tiền mặt đã đưa Cô Vân
  cashEndCalculated Int  @default(0) // auto = cashStart + roomRevenue + cafeRevenue + spaRevenue - otherExpense - ownerCashOut
  cashEndCounted    Int?

  pendingNotes String?

  handoverConfirmed   Boolean   @default(false)
  handoverConfirmedAt DateTime?
  receiverConfirmed   Boolean   @default(false)
  receiverConfirmedAt DateTime?

  createdAt DateTime @default(now())

  @@index([date])
}

// Ngưỡng cảnh báo tiền mặt + email nhận cảnh báo (key-value đơn giản)
model AppSetting {
  key   String @id
  value String
}
